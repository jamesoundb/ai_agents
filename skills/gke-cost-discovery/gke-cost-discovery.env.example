# Copy to gke-cost-discovery.env, fill in, then: set -a; . ./gke-cost-discovery.env; set +a
# Read-only access is enough: roles/container.clusterViewer, roles/monitoring.viewer,
# roles/logging.viewer on the project, plus cluster RBAC "view" for kubectl.
GCP_PROJECT=
GKE_CLUSTER=
GKE_LOCATION=            # region or zone of the cluster
KUBE_CONTEXT=            # optional; default current kubectl context
BUILD_NAMESPACES=        # optional, comma list, e.g. teamcity-agents,test-envs
DISCOVERY_DAYS=14
TEAMCITY_URL=            # e.g. https://teamcity.example.com
TEAMCITY_TOKEN=          # read-only access token (Profile -> Access Tokens)
