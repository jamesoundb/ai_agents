# Harness layouts are generated by install.sh. Only the bootstrap symlinks to the install-agents
# skill are committed, so that any harness opened in a fresh clone discovers that skill.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/install-agents
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/install-agents
.gemini/*
!.gemini/skills/
.gemini/skills/*
!.gemini/skills/install-agents
.github/agents/
.github/skills/*
!.github/skills/install-agents
# Engine artifacts
.ast-graph/
__pycache__/
*.pyc

# Secrets / local discovery data for gke-cost-discovery
gke-cost-discovery.env
discovery/

# Local worklogs (troubleshooting notes) are not published
.github/troubleshooting/
